# Run npm run env:init to create .env with random local database/Redis passwords.
DATABASE_URL=postgresql://sales:CHANGE_ME@127.0.0.1:5432/sales_copilot?schema=public
POSTGRES_USER=sales
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sales_copilot
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
WEB_ORIGIN=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:4000
API_PORT=4000
COOKIE_SECURE=false
# Optional explicit seed identity. No shared/default account is created.
SEED_EMAIL=
SEED_PASSWORD=
# Reserved for later stages; not used or sent to the browser in Foundation.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
AI_PROVIDER=
AI_API_KEY=
