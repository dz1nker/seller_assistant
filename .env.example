# Run npm run env:init to create .env with random local database/Redis passwords.
DATABASE_URL=postgresql://sales:CHANGE_ME@127.0.0.1:5432/sales_copilot?schema=public
POSTGRES_USER=sales
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sales_copilot
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
WEB_ORIGIN=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:4000
API_PORT=4000
COOKIE_SECURE=false
# Optional explicit seed identity. No shared/default account is created.
SEED_EMAIL=
SEED_PASSWORD=
# Internal credentials generated by env:init. Preserve the master key with backups.
GATEWAY_TOKEN=
SESSION_MASTER_KEY=
GATEWAY_URL=http://127.0.0.1:4101
# Obtain your own credentials at https://my.telegram.org/apps
# Keep them here, never in browser settings or chat.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# disabled / demo (synthetic rule-based examples) / openai (compatible API).
# Telegram content is excluded from all external AI calls in this MVP.
AI_PROVIDER=demo
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional prices per 1M tokens; absent prices are reported as unknown.
# AI_INPUT_COST_PER_MILLION=
# AI_OUTPUT_COST_PER_MILLION=
